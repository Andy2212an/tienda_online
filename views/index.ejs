<%- include('partials/header') %>

<!-- Fila de filtros y orden -->
<div class="row mb-4 g-2">
  <!-- Filtro por Marca -->
  <div class="col-12 col-md-4">
    <select id="filterMarca" class="form-select" aria-label="Filtrar por marca">
      <option value="" <%= !category ? 'selected' : '' %>>Todos los modelos</option>
      <% 
        // Obtener marcas únicas para filtro
        const marcasUnicas = [];
        celulares.forEach(c => {
          if (!marcasUnicas.includes(c.marca)) marcasUnicas.push(c.marca);
        });
        marcasUnicas.forEach(marca => { 
      %>
        <option value="<%= marca %>" <%= category === marca ? 'selected' : '' %>><%= marca %></option>
      <% }) %>
    </select>
  </div>

  <!-- Ordenar por Precio -->
  <div class="col-12 col-md-4">
    <select id="sortPrecio" class="form-select" aria-label="Ordenar por precio">
      <option value="" <%= !sort ? 'selected' : '' %>>Ordenar por Precio</option>
      <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>Precio Ascendente</option>
      <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>Precio Descendente</option>
    </select>
  </div>

  <!-- Buscador de Producto -->
  <div class="col-12 col-md-4">
    <form id="searchForm" class="d-flex" action="/celulares" method="get" role="search">
      <input id="searchInput" class="form-control me-2" type="search" placeholder="Buscar Celular" aria-label="Buscar" name="query" value="<%= query || '' %>" />
      <button class="btn btn-outline-success" type="submit">Buscar</button>
    </form>
  </div>
</div>

<!-- Cards de Celulares -->
<div class="row">
  <% celulares.forEach(celular => { %>
    <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-4">
      <div class="card h-100">
        <img src="<%= celular.imagen ? '/uploads/' + celular.imagen : '/uploads/default.jpg' %>" class="card-img-top" alt="<%= celular.modelo %>" />
        <div class="card-body d-flex flex-column">
          <h5 class="card-title"><%= celular.marca %> - <%= celular.modelo %></h5>
          <p class="card-text"><strong>Color:</strong> <%= celular.color %></p>
          <p class="card-text"><strong>Almacenamiento:</strong> <%= celular.almacenamiento %></p>
          <p class="card-text"><strong>RAM:</strong> <%= celular.ram %></p>
          <p class="card-text"><strong>Año:</strong> <%= celular.anio_lanzamiento %></p>
          <p class="card-text"><strong>Estado:</strong> <%= celular.estado %></p>
          <p class="card-text"><strong>Precio:</strong> $<%= celular.precio %></p>
          <div class="mt-auto d-flex justify-content-between">
            <a href="/celulares/edit/<%= celular.idcelular %>" class="btn btn-sm btn-info">Editar</a>

            <!-- Formulario para eliminar celular -->
            <form action="/celulares/delete/<%= celular.idcelular %>" method="POST" class="formEliminar d-inline">
              <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Confirmación para eliminar
    const formulariosEliminar = document.querySelectorAll(".formEliminar");
    formulariosEliminar.forEach(form => {
      form.addEventListener("submit", function(e) {
        e.preventDefault();
        Swal.fire({
          title: 'Celulares',
          text: '¿Está seguro de eliminar?',
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#d33',
          cancelButtonColor: '#3085d6',
          confirmButtonText: 'Sí, eliminar',
          cancelButtonText: 'Cancelar'
        }).then((result) => {
          if (result.isConfirmed) {
            this.submit();
          }
        });
      });
    });

    // Manejar filtro por marca y orden por precio
    const filterMarca = document.getElementById('filterMarca');
    const sortPrecio = document.getElementById('sortPrecio');
    const searchForm = document.getElementById('searchForm');
    const searchInput = document.getElementById('searchInput');

    function buildUrl() {
      const params = new URLSearchParams();

      if (filterMarca.value) {
        params.append('category', filterMarca.value);
      }
      if (sortPrecio.value) {
        params.append('sort', sortPrecio.value);
      }
      if (searchInput.value.trim()) {
        params.append('query', searchInput.value.trim());
      }
      return '/celulares?' + params.toString();
    }

    filterMarca.addEventListener('change', () => {
      window.location.href = buildUrl();
    });

    sortPrecio.addEventListener('change', () => {
      window.location.href = buildUrl();
    });

    // Al enviar el formulario de búsqueda, incluir filtros actuales
    searchForm.addEventListener('submit', (e) => {
      e.preventDefault();
      window.location.href = buildUrl();
    });
  });
</script>

<%- include('partials/footer') %>
