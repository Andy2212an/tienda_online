<%- include('partials/header') %>

<div class="table-responsive">
  <table class="table table-sm">
    <thead>
      <tr>
        <th>ID</th>
        <th>Marca</th>
        <th>Modelo</th>
        <th>Color</th>
        <th>Almacenamiento</th>
        <th>RAM</th>
        <th>Año</th>
        <th>Estado</th>
        <th>Operaciones</th>
      </tr>
    </thead>
    <tbody>
      <% celulares.forEach(celular => { %>
      <tr>
        <td><%= celular.idcelular %></td>
        <td><%= celular.marca %></td>
        <td><%= celular.modelo %></td>
        <td><%= celular.color %></td>
        <td><%= celular.almacenamiento %></td>
        <td><%= celular.ram %></td>
        <td><%= celular.anio_lanzamiento %></td>
        <td><%= celular.estado %></td>
        <td>
          <a href="/edit/<%= celular.idcelular %>" class="btn btn-sm btn-info">Editar</a>
          <a href="/delete/<%= celular.idcelular %>" class="btn btn-sm btn-danger delete">Eliminar</a>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const enlacesEliminar = document.querySelectorAll(".delete")

    enlacesEliminar.forEach(enlace => {
      enlace.addEventListener("click", (event) => {
        event.preventDefault();

        Swal.fire({
          title: 'Celulares',
          text: '¿Está seguro de eliminar?',
          icon: 'question',
          footer: 'SENATI - Ingeniería Software',
          confirmButtonText: 'Aceptar',
          confirmButtonColor: '#2980b9',
          showCancelButton: true,
          cancelButtonText: 'Cancelar',
          cancelButtonColor: '#c0392b'
        }).then((result) => {
          if (result.isConfirmed){
            window.location.href = event.target.getAttribute("href")
          }
        });
      });
    });
  });
</script>

<%- include('partials/footer') %>
